# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.ipynb
*.DS_Store
.vscode/
.ipynb_checkpoints/
docker/*
*.pickle
results/
tmp/
*-checkpoint.py
wandb/
outputs/
models/

# converted text-encoder weights (regenerate with setup_pretrained_text.py)
baselines/QLearning/pretrained_text/

# PBS job outputs (logs land in project root by default)
*.o[0-9]*
*.e[0-9]*

# Auto-generated job scripts (regenerated by scripts/submit_repro.sh; may
# contain wandb keys from prior runs).
scripts/jobs/

# JAX persistent compile cache
.jax_cache/

# claude-code session metadata
.claude/

# Local env (wandb keys etc.)
.env
